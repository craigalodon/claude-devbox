#!/bin/bash
# claude-dev — run Claude Code inside a rootless-podman sandbox with an egress allowlist.
#
#   claude-dev build                       (re)build the sandbox image
#   claude-dev up    <project-dir> [name]  start a Remote Control server for <project-dir> in a tmux session
#                                          (first run per project: /login and accept the trust dialog)
#   claude-dev login <project-dir>         sign in to claude.ai (again) for one project
#   claude-dev shell <project-dir>         interactive shell in the sandbox for <project-dir>
#   claude-dev ls                          list running sandboxes and per-project state
#   claude-dev attach <name>               attach to a sandbox's tmux session (Ctrl-b d to detach)
#   claude-dev down <name>                 stop a sandbox
#   claude-dev forget <project-dir>        delete a project's sandbox state (login, transcripts, tokens, caches)
#   claude-dev state <project-dir>         create (if needed) and print the project's state dir; the dir
#                                          needn't exist yet, e.g. to add a Bitbucket token before cloning
#
# Each project gets its own state under ~/sandbox/projects/<key>/ (Claude home, gh login, Bitbucket
# tokens, caches, history), so projects can't read or tamper with each other's. Global Claude config
# (~/sandbox/global/: managed-settings.json, CLAUDE.md) is mounted read-only at /etc/claude-code.
#
# Env: CLAUDE_DEV_MODE   permission mode for `up` (default: acceptEdits; e.g. bypassPermissions)
#      CLAUDE_DEV_SPAWN  where remote-spawned sessions run: worktree (default) or same-dir
set -euo pipefail
SANDBOX_DIR="$HOME/sandbox"
IMAGE="localhost/claude-sandbox:latest"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
# tmux needs a terminfo entry for $TERM; fall back if the client terminal (e.g. ghostty) is unknown here
infocmp "${TERM:-dumb}" >/dev/null 2>&1 || export TERM=xterm-256color

usage() { sed -n '2,21p' "$0"; exit 1; }
die() { echo "claude-dev: $*" >&2; exit 1; }

project_path() { [ -d "${1:-}" ] || die "not a directory: ${1:-(none)}"; realpath "$1"; }
# /home/dev/data-analytics -> home-dev-data-analytics (unique per path, readable)
project_key() { local k="${1#/}"; echo "${k//[^A-Za-z0-9._-]/-}"; }
state_dir() { echo "$SANDBOX_DIR/projects/$(project_key "$1")"; }

ensure_state() {  # ensure_state <project-path>
  local s; s=$(state_dir "$1")
  mkdir -p "$s"/{claude-home,history,gh-config,cache,uv-share,go,bb-credentials}
  chmod 700 "$s" "$s/bb-credentials"
  [ -e "$s/bb-credentials/credentials" ] || install -m 600 /dev/null "$s/bb-credentials/credentials"
  echo "$1" > "$s/project-path"
}

run_container() {  # run_container <project-path> <container-name> <cmd...>
  local project="$1" name="$2" s; shift 2
  [ -f "$SANDBOX_DIR/global/managed-settings.json" ] || die "$SANDBOX_DIR/global/ is missing — run install-dev.sh"
  ensure_state "$project"; s=$(state_dir "$project")
  local tty=(-i); [ -t 0 ] && tty=(-it)   # no TTY when scripted: `echo cmd | claude-dev shell <dir>`
  podman run --rm "${tty[@]}" --name "$name" --hostname "$name" \
    --userns=keep-id:uid=1000,gid=1000 \
    --cap-add NET_ADMIN --cap-add NET_RAW \
    -v "$project":/workspace \
    -v "$SANDBOX_DIR/global":/etc/claude-code:ro \
    -v "$s/claude-home":/home/node/.claude \
    -v "$s/history":/commandhistory \
    -v "$s/gh-config":/home/node/.config/gh \
    -v "$s/bb-credentials":/home/node/.config/bitbucket:ro \
    -v "$s/cache":/home/node/.cache \
    -v "$s/uv-share":/home/node/.local/share/uv \
    -v "$s/go":/home/node/go \
    -v "$HOME/.gitconfig":/home/node/.gitconfig:ro \
    -e TZ="${TZ:-Etc/UTC}" \
    -e NODE_OPTIONS=--max-old-space-size=4096 \
    -w /workspace \
    "$IMAGE" "$@"
}

# remote-control needs a claude.ai login and an accepted /workspace trust dialog in the project's Claude home
first_run_needed() {
  local home; home="$(state_dir "$1")/claude-home"
  [ -s "$home/.credentials.json" ] || return 0
  ! python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if d.get("projects",{}).get("/workspace",{}).get("hasTrustDialogAccepted") else 1)' \
      "$home/.claude.json" 2>/dev/null
}

cmd="${1:-}"; shift || true
case "$cmd" in
  build)
    podman build -t "$IMAGE" --build-arg TZ="${TZ:-Etc/UTC}" "$SANDBOX_DIR" ;;
  up)
    project=$(project_path "${1:-}"); name="${2:-cc-$(basename "$project")}"
    mode="${CLAUDE_DEV_MODE:-acceptEdits}"; spawn="${CLAUDE_DEV_SPAWN:-worktree}"
    if tmux has-session -t "$name" 2>/dev/null; then die "tmux session $name already exists (claude-dev attach $name)"; fi
    if first_run_needed "$project"; then
      echo ">> First run for this project: in Claude, run /login if asked, accept the trust dialog, then /exit."
      run_container "$project" "$name-setup" claude
      first_run_needed "$project" && die "still not logged in / trusted — run 'claude-dev up' again"
    fi
    tmux new-session -d -s "$name" \
      "$0 _run '$project' '$name' claude remote-control --name '$name' --permission-mode '$mode' --spawn='$spawn' --sandbox; echo; echo '[sandbox exited — press Enter to close]'; read"
    echo "started sandbox '$name' for $project (mode: $mode, spawn: $spawn)"
    echo "  watch:  claude-dev attach $name      stop: claude-dev down $name"
    echo "  session will appear at https://claude.ai/code once connected" ;;
  _run) run_container "$1" "$2" "${@:3}" ;;
  login)
    project=$(project_path "${1:-}")
    echo ">> In Claude, run /login and follow the URL. Then /exit."
    run_container "$project" "cc-login-$$" claude ;;
  shell)
    project=$(project_path "${1:-}"); run_container "$project" "cc-shell-$$" bash ;;
  ls)
    echo "== containers =="; podman ps --format 'table {{.Names}}\t{{.Status}}\t{{.RunningFor}}'
    echo "== tmux =="; tmux ls 2>/dev/null || echo "(none)"
    echo "== project state (~/sandbox/projects) =="
    for s in "$SANDBOX_DIR"/projects/*/; do
      [ -d "$s" ] || continue
      printf '%-8s %-40s %s\n' "$(du -sh "$s" 2>/dev/null | cut -f1)" "$(basename "$s")" "$(cat "$s/project-path" 2>/dev/null)"
    done ;;
  attach) tmux attach -t "${1:?name required}" ;;
  down)
    name="${1:?name required}"; podman stop -t 10 "$name" 2>/dev/null || true
    tmux kill-session -t "$name" 2>/dev/null || true; echo "stopped $name" ;;
  state)
    [ -n "${1:-}" ] || die "project dir required"
    project=$(realpath -m "$1"); ensure_state "$project"; state_dir "$project" ;;
  forget)
    [ -n "${1:-}" ] || die "project dir required"
    if [ -d "$1" ]; then s=$(state_dir "$(realpath "$1")"); else s=$(state_dir "$(realpath -m "$1")"); fi
    [ -d "$s" ] || die "no state for $1 ($s)"
    du -sh "$s"; read -r -p "Delete all sandbox state for $1 (login, transcripts, tokens, caches)? [y/N] " ok
    [ "$ok" = y ] || { echo "kept"; exit 0; }
    podman unshare rm -rf "$s"; echo "deleted $s" ;;
  *) usage ;;
esac
